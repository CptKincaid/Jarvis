[Unit]
Description=Jarvis weekly Knightfall code: pull
Documentation=file:%h/Jarvis/jarvis/knightfall_weekly.py
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Jarvis
ExecStart=%h/vss_env/bin/python -m jarvis.knightfall_weekly pull
# One ssh round trip bounded to 20 s and one locked write.
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=false
Nice=10
